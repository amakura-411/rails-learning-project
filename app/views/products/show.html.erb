<h1>
  <% cache @product do %>
    <%= @product.name %>
  <% end %>
</h1>

<%= link_to "Back", products_path %>
<% if authenticated? %>
  <%= link_to "Edit", edit_product_path(@product) %>
  <%= button_to "Delete",
  @product,
  method: :delete,
  data: {
    turbo_confirm: "Are you sure?",
  } %>
<% end %>
